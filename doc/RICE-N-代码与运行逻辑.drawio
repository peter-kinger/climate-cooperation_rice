          <mxGeometry x="40" y="575" width="400" height="130" as="geometry" />
        </mxCell>
        <mxCell id="t4" value="algo.save()&#10;保存完整 checkpoint/&#10;保存实际 config.yaml 与路径提示" style="rounded=1;whiteSpace=wrap;html=0;align=left;verticalAlign=middle;spacing=16;fontSize=16;fontFamily=Microsoft YaHei;fillColor=#eaf7ef;strokeColor=#62a37c;fontColor=#25364b;" vertex="1" parent="1">
          <mxGeometry x="40" y="775" width="400" height="105" as="geometry" />
        </mxCell>
        <mxCell id="t5" value="finally&#10;algo.stop()；ray.shutdown()" style="rounded=1;whiteSpace=wrap;html=0;align=left;verticalAlign=middle;spacing=16;fontSize=16;fontFamily=Microsoft YaHei;fillColor=#fff5df;strokeColor=#c69a46;fontColor=#25364b;" vertex="1" parent="1">
          <mxGeometry x="40" y="945" width="400" height="90" as="geometry" />
        </mxCell>
        <mxCell id="e1" value="evaluate.main()&#10;读取 runs/&lt;实验名&gt;/config.yaml&#10;setup() 注册环境和模型" style="rounded=1;whiteSpace=wrap;html=0;align=left;verticalAlign=middle;spacing=16;fontSize=16;fontFamily=Microsoft YaHei;fillColor=#eef4ff;strokeColor=#6385bd;fontColor=#25364b;" vertex="1" parent="1">
          <mxGeometry x="520" y="235" width="400" height="105" as="geometry" />
        </mxCell>
        <mxCell id="e2" value="Algorithm.from_checkpoint()&#10;从 runs/&lt;实验名&gt;/checkpoint 恢复&#10;不更新策略参数" style="rounded=1;whiteSpace=wrap;html=0;align=left;verticalAlign=middle;spacing=16;fontSize=16;fontFamily=Microsoft YaHei;fillColor=#eef4ff;strokeColor=#6385bd;fontColor=#25364b;" vertex="1" parent="1">
          <mxGeometry x="520" y="405" width="400" height="105" as="geometry" />
        </mxCell>
        <mxCell id="e3" value="每个评估回合&#10;RiceEnv.reset() → compute_single_action()&#10;→ RiceEnv.step() → 直到 terminated&#10;默认 explore=False；可加 --explore" style="rounded=1;whiteSpace=wrap;html=0;align=left;verticalAlign=middle;spacing=16;fontSize=16;fontFamily=Microsoft YaHei;fillColor=#eef4ff;strokeColor=#6385bd;fontColor=#25364b;" vertex="1" parent="1">
          <mxGeometry x="520" y="575" width="400" height="130" as="geometry" />
        </mxCell>
        <mxCell id="e4" value="提取 global_state；检查有限数值&#10;原始轨迹：trajectory_*.npz&#10;按 activity_timestep 筛出经济年份&#10;谈判中间步骤不当作新增年份" style="rounded=1;whiteSpace=wrap;html=0;align=left;verticalAlign=middle;spacing=16;fontSize=16;fontFamily=Microsoft YaHei;fillColor=#eef4ff;strokeColor=#6385bd;fontColor=#25364b;" vertex="1" parent="1">
          <mxGeometry x="520" y="775" width="400" height="130" as="geometry" />
        </mxCell>
        <mxCell id="e5" value="导出评估结果；关闭算法和 Ray&#10;evaluation.csv：全球年度结果&#10;regions.csv；summary.json" style="rounded=1;whiteSpace=wrap;html=0;align=left;verticalAlign=middle;spacing=16;fontSize=16;fontFamily=Microsoft YaHei;fillColor=#eaf7ef;strokeColor=#62a37c;fontColor=#25364b;" vertex="1" parent="1">
          <mxGeometry x="520" y="975" width="400" height="105" as="geometry" />
        </mxCell>
        <mxCell id="p1" value="plot.main()&#10;读取 evaluation.csv&#10;按年份聚合并绘制全球六面板" style="rounded=1;whiteSpace=wrap;html=0;align=left;verticalAlign=middle;spacing=16;fontSize=16;fontFamily=Microsoft YaHei;fillColor=#eef4ff;strokeColor=#6385bd;fontColor=#25364b;" vertex="1" parent="1">
          <mxGeometry x="1000" y="235" width="400" height="105" as="geometry" />
        </mxCell>
        <mxCell id="p2" value="读取 regions.csv&#10;按地区 / 年份聚合&#10;绘制各地区减排曲线" style="rounded=1;whiteSpace=wrap;html=0;align=left;verticalAlign=middle;spacing=16;fontSize=16;fontFamily=Microsoft YaHei;fillColor=#eef4ff;strokeColor=#6385bd;fontColor=#25364b;" vertex="1" parent="1">
          <mxGeometry x="1000" y="405" width="400" height="105" as="geometry" />
        </mxCell>
        <mxCell id="p3" value="读取 training.csv&#10;绘制平均回合奖励曲线&#10;只有一次迭代时，仅有一个训练点" style="rounded=1;whiteSpace=wrap;html=0;align=left;verticalAlign=middle;spacing=16;fontSize=16;fontFamily=Microsoft YaHei;fillColor=#eef4ff;strokeColor=#6385bd;fontColor=#25364b;" vertex="1" parent="1">
