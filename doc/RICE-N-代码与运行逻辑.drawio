          <mxGeometry x="520" y="445" width="400" height="100" as="geometry" />
        </mxCell>
        <mxCell id="accept" value="true 且 stage == 2&#10;evaluation_step() / rice.py:584&#10;接受 / 拒绝；更新最低减排率" style="rounded=1;whiteSpace=wrap;html=0;align=left;verticalAlign=middle;spacing=16;fontSize=16;fontFamily=Microsoft YaHei;fillColor=#eef4ff;strokeColor=#6385bd;fontColor=#25364b;" vertex="1" parent="1">
          <mxGeometry x="1000" y="445" width="400" height="100" as="geometry" />
        </mxCell>
        <mxCell id="talkreturn" value="谈判步骤返回&#10;新观察；各地区 reward = 0；done = false&#10;年份与 activity_timestep 均不推进" style="rounded=1;whiteSpace=wrap;html=0;align=left;verticalAlign=middle;spacing=16;fontSize=16;fontFamily=Microsoft YaHei;fillColor=#fff5df;strokeColor=#c69a46;fontColor=#25364b;" vertex="1" parent="1">
          <mxGeometry x="760" y="630" width="480" height="100" as="geometry" />
        </mxCell>
        <mxCell id="activity" value="climate_and_economy_simulation_step()&#10;false：每次调用；true：stage == 0 时调用&#10;activity_timestep += 1；更新气候经济&#10;current_year += 5；reward = 当期效用" style="rounded=1;whiteSpace=wrap;html=0;align=left;verticalAlign=middle;spacing=16;fontSize=16;fontFamily=Microsoft YaHei;fillColor=#fff5df;strokeColor=#c69a46;fontColor=#25364b;" vertex="1" parent="1">
          <mxGeometry x="40" y="630" width="600" height="125" as="geometry" />
        </mxCell>
        <mxCell id="mask" value="generate_action_mask() / rice.py:505&#10;把低于最低减排要求的动作设为无效&#10;MaskedModel.forward() 屏蔽对应 logits" style="rounded=1;whiteSpace=wrap;html=0;align=left;verticalAlign=middle;spacing=16;fontSize=16;fontFamily=Microsoft YaHei;fillColor=#eef4ff;strokeColor=#6385bd;fontColor=#25364b;" vertex="1" parent="1">
          <mxGeometry x="760" y="815" width="480" height="105" as="geometry" />
        </mxCell>
        <mxCell id="return" value="generate_observation()；返回奖励与 done&#10;到达 2115 年时回合结束&#10;未结束则策略根据新观察选择下一步动作" style="rounded=1;whiteSpace=wrap;html=0;align=left;verticalAlign=middle;spacing=16;fontSize=16;fontFamily=Microsoft YaHei;fillColor=#eef4ff;strokeColor=#6385bd;fontColor=#25364b;" vertex="1" parent="1">
          <mxGeometry x="40" y="840" width="600" height="95" as="geometry" />
        </mxCell>
        <mxCell id="notes" value="时间顺序：提案（1）→ 接受 / 拒绝（2）→ 气候经济活动（0）→ 下一周期提案。&#10;开启谈判：60 个环境步骤，仍只有 20 个经济周期；谈判步骤本身不推进年份。&#10;接受多个协议时，地区最低减排率取相关已接受承诺 / 要求的最大值；执行依靠动作掩码。&#10;切换谈判开关后需重新训练，因为动作与观察维度发生变化。" style="rounded=1;whiteSpace=wrap;html=0;align=left;verticalAlign=middle;spacing=16;fontSize=16;fontFamily=Microsoft YaHei;fillColor=#f4f2f8;strokeColor=#9a8fb0;fontColor=#25364b;" vertex="1" parent="1">
          <mxGeometry x="40" y="1040" width="1360" height="145" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
