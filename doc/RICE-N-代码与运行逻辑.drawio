        </mxCell>
        <mxCell id="step" value="Rice.step(actions)  / rice.py:345&#10;timestep += 1；复制上一状态（奖励除外）&#10;negotiation_on 为真时：stage = timestep % 3" style="rounded=1;whiteSpace=wrap;html=0;align=left;verticalAlign=middle;spacing=16;fontSize=16;fontFamily=Microsoft YaHei;fillColor=#eef4ff;strokeColor=#6385bd;fontColor=#25364b;" vertex="1" parent="1">
          <mxGeometry x="420" y="260" width="600" height="105" as="geometry" />
        </mxCell>
        <mxCell id="off" value="negotiation_on = false&#10;每一步直接进入活动模块&#10;20 个环境步骤 = 20 个经济周期" style="rounded=1;whiteSpace=wrap;html=0;align=left;verticalAlign=middle;spacing=16;fontSize=16;fontFamily=Microsoft YaHei;fillColor=#fff0ea;strokeColor=#c7836b;fontColor=#25364b;" vertex="1" parent="1">
          <mxGeometry x="40" y="445" width="400" height="100" as="geometry" />
