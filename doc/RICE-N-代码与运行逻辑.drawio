        <mxCell id="commands" value="逐步运行：&#10;uv run python -m rllib_cpu.train --iterations 1 --output runs/my-run&#10;uv run python -m rllib_cpu.evaluate --run runs/my-run --episodes 1&#10;uv run python -m rllib_cpu.plot --run runs/my-run&#10;一键运行：powershell -ExecutionPolicy Bypass -File .\run_all.ps1 -RunDir runs/my-run -Iterations 1" style="rounded=1;whiteSpace=wrap;html=0;align=left;verticalAlign=middle;spacing=16;fontSize=16;fontFamily=Microsoft YaHei;fillColor=#f4f2f8;strokeColor=#9a8fb0;fontColor=#25364b;" vertex="1" parent="1">
